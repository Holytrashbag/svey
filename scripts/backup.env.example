# Backup configuration for scripts/backup-db.sh
# Copy to /opt/svey/.backup.env on the server (gitignored — NEVER commit).
#   cp scripts/backup.env.example /opt/svey/.backup.env
#
# IMPORTANT: the PRIVATE key half of AGE_RECIPIENT must be stored OFF this
# server (password manager / offline). It is only needed to restore.

# age recipient (PUBLIC key). Every backup is encrypted to this key.
# Generate a keypair on your laptop (not the server):
#   age-keygen -o svey-backup.key
# It prints "Public key: age1..." — paste that value here.
AGE_RECIPIENT=age1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Off-site target: a dedicated directory on your Hetzner Storage Box.
# Format: <user>@<user>.your-storagebox.de:<subdir>
STORAGEBOX_DEST=u123456@u123456.your-storagebox.de:backups/svey

# SSH transport for rsync. Hetzner Storage Boxes use port 23. Quote it (spaces).
RSYNC_RSH="ssh -p 23"

# Optional: days of backups to keep, locally and mirrored off-site (default 14).
# RETENTION_DAYS=14
