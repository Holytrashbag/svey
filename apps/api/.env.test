# Deterministic, non-secret config for `pnpm test` (also used in CI).
# Tests never touch a real database or OAuth provider.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/svey_test
BETTER_AUTH_SECRET=test-secret-not-used-anywhere-real-0000
BETTER_AUTH_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
DISCORD_CLIENT_ID=test
DISCORD_CLIENT_SECRET=test
GOOGLE_CLIENT_ID=test
GOOGLE_CLIENT_SECRET=test
NODE_ENV=test
