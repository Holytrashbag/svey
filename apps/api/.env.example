# ── API environment (development) ──
# Copy to apps/api/.env for local dev. For production see .env.prod.example
# at the repo root (values are injected by docker-compose.prod.yml).

# Better Auth (dev). Generate a secret with: openssl rand -base64 48
BETTER_AUTH_SECRET=dev-secret-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:3000

# Database (local docker compose: `pnpm db:up`)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/svey

# Frontend origin (CORS + Better Auth trustedOrigins)
FRONTEND_URL=http://localhost:5173

# Discord OAuth — https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Google OAuth — https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Server
NODE_ENV=development
PORT=3000

# Optional: override where uploaded avatars are stored. In production this is
# set to a persistent volume path (see docker-compose.prod.yml).
# UPLOADS_DIR=/data/uploads

# Transactional email (password reset, email verification).
# Leave unset in dev: emails are then logged to the API console (incl. the link).
# In production set these to your SMTP provider (Brevo, Mailgun, Postmark, Resend
# SMTP, …) and a sender on a domain with SPF/DKIM configured.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# EMAIL_FROM=Svey <noreply@svey.app>
