# Environment for the Playwright end-to-end suite (apps/frontend/e2e/). Committed
# on purpose, like .env.test: dummy values only, nothing here is a secret.
# Ports must match apps/frontend/.env.e2e and apps/frontend/e2e/env.ts.

# Separate database on the docker-compose Postgres; recreated on every run by
# jobs/reset-e2e-database.ts (which refuses any name not ending in _e2e).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/svey_e2e

BETTER_AUTH_SECRET=e2e-secret-not-used-anywhere-real-000000
BETTER_AUTH_URL=http://localhost:3100
FRONTEND_URL=http://localhost:4174
PORT=3100

# Not "test": Better Auth skips its origin/CSRF checks under NODE_ENV=test, and
# the suite should exercise the real CORS + trusted-origins path.
NODE_ENV=development

# OAuth is out of scope for the suite; the values only satisfy lib/env.ts.
DISCORD_CLIENT_ID=e2e
DISCORD_CLIENT_SECRET=e2e
GOOGLE_CLIENT_ID=e2e
GOOGLE_CLIENT_SECRET=e2e
