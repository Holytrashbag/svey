{
  "name": "api",
  "version": "1.1.0",
  "private": true,
  "description": "Fastify REST API for Svey",
  "author": "Moritz Wirth",
  "license": "MIT",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "migrate": "node --env-file=.env --experimental-strip-types db/migrate.ts",
    "seed": "node --env-file=.env --experimental-strip-types jobs/seed-demo.ts",
    "cleanup": "node --env-file=.env --experimental-strip-types jobs/cleanup-orphans.ts",
    "encrypt-tokens": "node --env-file=.env --experimental-strip-types jobs/encrypt-tokens.ts",
    "db:push": "drizzle-kit push --config=drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=drizzle.config.ts",
    "test": "node --env-file=.env.test --experimental-strip-types --test \"{test,lib,services}/**/*.test.ts\"",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "dev": "node --env-file=.env --import tsx --watch server.ts",
    "e2e:prepare": "node --env-file=.env.e2e --experimental-strip-types jobs/reset-e2e-database.ts && node --env-file=.env.e2e --experimental-strip-types db/migrate.ts && node --env-file=.env.e2e --experimental-strip-types jobs/seed-demo.ts",
    "e2e:serve": "pnpm e2e:prepare && node --env-file=.env.e2e --import tsx server.ts"
  },
  "dependencies": {
    "@fastify/autoload": "^6.5.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.2",
    "@fastify/static": "^10.1.5",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "fastify-cli": "^8.0.3",
    "tsx": "^4.23.15"
  }
}
