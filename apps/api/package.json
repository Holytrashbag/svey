{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "description": "Fastify REST API for Svey",
  "author": "Moritz Wirth",
  "license": "MIT",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "migrate": "node --env-file=.env --experimental-strip-types db/migrate.ts",
    "seed": "node --env-file=.env --experimental-strip-types jobs/seed-demo.ts",
    "cleanup": "node --env-file=.env --experimental-strip-types jobs/cleanup-orphans.ts",
    "encrypt-tokens": "node --env-file=.env --experimental-strip-types jobs/encrypt-tokens.ts",
    "db:push": "drizzle-kit push --config=drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=drizzle.config.ts",
    "test": "node --env-file=.env.test --experimental-strip-types --test \"{test,lib,services}/**/*.test.ts\"",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "dev": "node --env-file=.env --import tsx --watch server.ts"
  },
  "dependencies": {
    "@fastify/autoload": "^6.0.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^9.1.3",
    "better-auth": "^1.6.11",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.11",
    "pg": "^8.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "fastify-cli": "^8.0.0",
    "tsx": "^4.22.0"
  }
}
