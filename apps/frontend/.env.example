# API origin. The app requests `${VITE_API_URL}/api/...` and Better Auth uses
# it as its baseURL.
#   Dev:  point at the local API.
#   Prod: set to your public site origin (same origin as the SPA); this is
#         passed as a build arg by docker-compose.prod.yml, not read from here.
VITE_API_URL=http://localhost:3000

# Operator contact details shown on the Impressum / Datenschutz pages. Kept out
# of the repository; unset values render as "[…]" placeholders. In production
# these are build args (see docker-compose.prod.yml and the deploy workflow).
# VITE_LEGAL_NAME=Jane Doe
# VITE_LEGAL_STREET=Musterstraße 1
# VITE_LEGAL_CITY=10115 Berlin
# VITE_LEGAL_EMAIL=hello@example.com
# VITE_LEGAL_PHONE=+49 30 1234567
