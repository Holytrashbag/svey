{
  "name": "frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Vue 3 single-page app for Svey",
  "author": "Moritz Wirth",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p check-types \"build-only {@}\" --",
    "build-only": "vite build",
    "preview": "vite preview",
    "check-types": "vue-tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "run-s lint:oxlint lint:eslint",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "lint:check": "oxlint . && eslint .",
    "format": "oxfmt src/"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "better-auth": "^1.7.6",
    "pinia": "^4.0.3",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@tsconfig/node26": "^26.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.86.0",
    "eslint-plugin-vue": "~10.11.1",
    "jiti": "^2.6.1",
    "jsdom": "^30.1.1",
    "npm-run-all2": "^8.0.4",
    "oxfmt": "^0.71.0",
    "oxlint": "~1.86.0",
    "typescript": "~6.0.0",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.11",
    "workbox-window": "^7.4.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
