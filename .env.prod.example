# ── Production environment for docker-compose.prod.yml ──
# Copy to .env.prod and fill in real values. NEVER commit .env.prod.
#   cp .env.prod.example .env.prod
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build

# Public site. SITE_ADDRESS drives Caddy's automatic HTTPS (no scheme);
# SITE_URL is the full origin baked into the SPA build.
SITE_ADDRESS=svey.app
SITE_URL=https://svey.app

# Operator details for the Impressum / Datenschutz pages (legally required in
# Germany). Baked into the SPA at build time; only used when building the web
# image on the host. CI builds take them from the VITE_LEGAL_* repo secrets.
VITE_LEGAL_NAME=
VITE_LEGAL_STREET=
VITE_LEGAL_CITY=
VITE_LEGAL_EMAIL=
VITE_LEGAL_PHONE=

# Postgres. DATABASE_URL is assembled from these inside compose, so the
# password is defined in exactly one place.
POSTGRES_USER=svey
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=svey

# Better Auth. On a single origin these match SITE_URL.
# Generate a secret with: openssl rand -base64 48
BETTER_AUTH_SECRET=replace-with-a-random-string-at-least-32-chars
BETTER_AUTH_URL=https://svey.app
FRONTEND_URL=https://svey.app

# Discord OAuth — https://discord.com/developers/applications
# Redirect URI: https://svey.app/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Google OAuth — https://console.cloud.google.com/
# Redirect URI: https://svey.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional email (password reset, email verification) via Brevo SMTP.
# SMTP_USER / SMTP_PASS come from Brevo → "SMTP & API" → "SMTP" tab
# (login + a generated SMTP key). The sender domain svey.app must be
# authenticated in Brevo (DKIM/SPF DNS records added at Cloudflare).
# If these are left empty, emails are logged to the API console instead of sent.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Svey <no-reply@svey.app>
